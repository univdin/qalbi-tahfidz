NEXT_PUBLIC_SUPABASE_URL=https://axohgicormvtfilqcajn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase (JANGAN di-expose ke client/browser).
# Diisi dari Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# URL publik situs (dipakai untuk canonical, sitemap, Open Graph, llms.txt).
# Wajib diisi di lingkungan production, mis. https://quran.ilmify.id
NEXT_PUBLIC_SITE_URL=

# Cloudflare Workers AI (speech verification). Buat token di dashboard Cloudflare
# dengan permission "Workers AI -> Edit" scope Entire Account, TANPA IP filter.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Quran.com API (@quranjs/api) — akses diajukan di https://api-docs.quran.foundation/request-access/
# Aplikasi terdaftar dengan nama "ILMIFY QURAN". Isi bila kredensial sudah disetujui;
# tanpa kredensial, sistem otomatis fallback ke per-ayah everyayah.com + Tier 2/3.
QURAN_API_CLIENT_ID=
QURAN_API_CLIENT_SECRET=

# Resend (opsional) — SMTP untuk email auth Supabase.
# Konfigurasi di Supabase Dashboard → Authentication → SMTP Settings:
#   host: smtp.resend.com · port: 465 (SSL) / 587 / 2255 · user: resend · password: <RESEND_API_KEY>
# Sender: QalbiTahfidz <noreply@quran.ilmify.id> (domain harus diverifikasi di Resend)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Qurani.ai (free tier) — REST API + MCP mcp.quran.ai
QURANI_QRC_KEY=
QURANI_SEMANTIC_KEY=
